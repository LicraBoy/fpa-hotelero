{
  "name": "fpa-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && node scripts/verificar_seguridad.mjs",
    "preview": "vite preview",
    "e2e": "playwright test",
    "api:tipos": "node scripts/generar_tipos.mjs",
    "test:unit": "node --test \"src/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "seguridad": "node scripts/verificar_seguridad.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "plotly.js-basic-dist-min": "^4.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-plotly.js": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
