# Copia este archivo como ".env" (el .env real NO se sube al repositorio).
# Todas las variables llevan el prefijo FPA_

# Base de datos. Desarrollo y pruebas: SQLite.
FPA_DATABASE_URL=sqlite:///./fpa_dev.db
# Ejemplo futuro (PostgreSQL), ver docs/CAMBIOS_FUTUROS_DE_TECNOLOGIA.md:
# FPA_DATABASE_URL=postgresql+psycopg://usuario:clave@servidor:5432/fpa

# Entorno. "produccion" (por defecto) NO autentica a nadie hasta configurar OIDC.
# "desarrollo" habilita la identidad de desarrollo (cabecera X-Usuario-Dev). Solo en local.
FPA_ENTORNO=desarrollo

# Ruta de la carpeta con los Excel reales de Torres (solo para pruebas locales)
# FPA_DATOS_REALES=C:\Users\mzamora\Desktop\PLATAFORMA FP&A E INTELIGENCIA HOTELERA
